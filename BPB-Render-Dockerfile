FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    WRANGLER_SEND_METRICS=false \
    PORT=10000 \
    DATA_DIR=/data \
    RUNTIME_DIR=/var/tmp/bpb-render-runtime \
    TMPDIR=/var/tmp

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 https://github.com/bia-pain-bache/BPB-Worker-Panel.git /app

RUN npm install --include=dev --no-audit --no-fund \
    && npm run check \
    && npm run build \
    && mkdir -p /data /var/tmp/bpb-render-runtime

RUN node -e "const fs=require('fs'); const p='/app/src/worker.ts'; let s=fs.readFileSync(p,'utf8'); const marker=\"init(request, env);\\n\\t\\t\\tconst healthPath = new URL(request.url).pathname;\\n\\t\\t\\tif (healthPath === '/healthz') return new Response('ok', { status: 200 });\\n\\t\\t\\tif (healthPath === '/') return new Response('BPB Worker Panel is running.', { status: 200 });\"; if(!s.includes(marker)){if(!s.includes('init(request, env);')) throw new Error('worker source pattern not found'); s=s.replace('init(request, env);',marker,1); fs.writeFileSync(p,s)}"

RUN npm run check && npm run build

RUN cat > /app/scripts/render-entry.mjs <<'NODE'
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { randomUUID, randomBytes } from 'node:crypto';
import { spawn } from 'node:child_process';

const dataDir = process.env.DATA_DIR || '/data';
const runtimeDir = process.env.RUNTIME_DIR || '/var/tmp/bpb-render-runtime';
const port = Number(process.env.PORT || 10000);
mkdirSync(dataDir, { recursive: true });
mkdirSync(runtimeDir, { recursive: true });

const csv = (value, fallback = []) => value ? value.split(',').map(x => x.trim()).filter(Boolean) : fallback;
const isUuid = value => /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value || '');
const settings = {
  accID: process.env.CF_ACCOUNT_ID || '',
  accEmail: (process.env.CF_ACCOUNT_EMAIL || 'render@localhost').toLowerCase(),
  apiToken: process.env.CF_API_TOKEN || '',
  vlUUID: isUuid(process.env.VL_UUID) ? process.env.VL_UUID : randomUUID(),
  trPass: process.env.TR_PASS || randomBytes(18).toString('base64url'),
  securePath: process.env.SECURE_PATH || randomBytes(16).toString('hex'),
  proxyIpMode: process.env.PROXY_IP_MODE || 'proxyip',
  proxyIPs: csv(process.env.PROXY_IPS, ['bpb.yousef.isegaro.com']),
  prefixes: csv(process.env.PROXY_PREFIXES, ['[2a02:898:146:64::]', '[2602:fc59:b0:64::]', '[2602:fc59:11:64::]']),
  mainDomain: process.env.MAIN_DOMAIN || '',
  fallback: process.env.FALLBACK || '',
  dohUrl: process.env.DOH_URL || 'https://cloudflare-dns.com/dns-query'
};

let worker = readFileSync('/app/dist/worker.js', 'utf8');
worker = `Object.assign(globalThis, { EMBEDED_SETTINGS: ${JSON.stringify(settings)} });\n` + worker;
const workerFile = `${runtimeDir}/worker.js`;
const configFile = `${runtimeDir}/wrangler.jsonc`;
writeFileSync(workerFile, worker);
writeFileSync(configFile, JSON.stringify({
  name: 'bpb-render', main: workerFile, compatibility_date: '2026-06-03',
  compatibility_flags: ['nodejs_compat'], no_bundle: true,
  kv_namespaces: [{ binding: 'kv', id: 'bpb-render-kv', preview_id: 'bpb-render-kv' }]
}, null, 2));

const child = spawn('npx', ['--yes', 'wrangler@4', 'dev', '--config', configFile, '--local', '--ip', '0.0.0.0', '--port', String(port), '--persist-to', dataDir, '--show-interactive-dev-session', 'false'], {
  stdio: 'inherit', env: { ...process.env, NODE_DISABLE_COMPILE_CACHE: '1' }
});
child.on('exit', (code, signal) => { if (signal) process.kill(process.pid, signal); process.exit(code ?? 1); });
NODE

RUN node --check /app/scripts/render-entry.mjs

EXPOSE 10000
VOLUME ["/data"]
CMD ["node", "/app/scripts/render-entry.mjs"]
